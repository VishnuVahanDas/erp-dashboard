# Copy to .env (gitignored). Read by docker compose AND by the backend when
# run natively from backend/ (it also looks in ../.env).
# Process environment variables take precedence. No inline comments: values are read verbatim.

# --- Native backend (./mvnw exec:java) ---
# With `docker compose up -d db` the database is on localhost:5433.
PG_URL=jdbc:postgresql://localhost:5433/vyom_erp
PG_USER=vyom
PG_PASSWORD=vyom_dev
# PORT=8080

# --- First director (seeded only while no active director exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Docker compose ---
# The stack sets the backend's PG_* itself from these.
# POSTGRES_DB=vyom_erp
# POSTGRES_USER=vyom
# POSTGRES_PASSWORD=vyom_dev
# DB_PORT=5433
# DB_BIND=127.0.0.1
# WEB_PORT=8088
# WEB_BIND=127.0.0.1
